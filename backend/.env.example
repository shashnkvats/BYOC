# Same Supabase project/keys the Next.js frontend uses (see ../.env.example).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Jev / TypeSafe - the non-generative decision model that powers every
# classifier. Get your key from console.typesafe.ai -> Settings -> Keys
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional: powers the "auto-draft from a paragraph" builder assist feature.
# Uses a Vercel AI Gateway-compatible OpenAI-style endpoint. Leave empty to
# disable the feature (the guided form still works without it - Jev never
# generates free text, so this is the only place an LLM is used at all).
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=openai/gpt-5.1

# CORS - the Next.js dev server origin(s), comma-separated
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
